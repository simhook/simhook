# Where the browser reaches the API. Must match SIMHOOK_WEB_URL's counterpart on the API side.
NEXT_PUBLIC_API_URL=http://localhost:8080

# The dashboard sends a visitor without the API's signed-in flag cookie to
# sign-in before a page loads. Set to "off" only when the dashboard and the API
# share no parent domain, so the flag can never reach the dashboard.
# SIMHOOK_SESSION_FLAG=off
