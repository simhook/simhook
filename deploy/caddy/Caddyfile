# Values in {$...} come from the environment set in docker-compose.prod.yaml.
{
	email {$ACME_EMAIL}
	servers {
		# Cloudflare sits in front of us. Trust its ranges, and take the
		# visitor's address from the header only Cloudflare writes; anything a
		# client can send itself (X-Forwarded-For) is not believed.
		trusted_proxies cloudflare {
			interval 12h
			timeout 15s
		}
		client_ip_headers CF-Connecting-IP
	}
}

(cloudflare_tls) {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}
}

# The same protective headers on every host. Nothing here is framed by
# anyone, nothing is sniffed, and referrers stay on our side.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
		-X-Powered-By
	}
}

# The dashboard and the API are not for search engines: simhook.dev is the
# one address a result should point at. The hosts stay crawlable so the
# header is actually seen.
(noindex) {
	header X-Robots-Tag "noindex, nofollow"
}

{$API_DOMAIN} {
	import cloudflare_tls
	import security_headers
	import noindex
	encode zstd gzip
	# The API reads the visitor's address from X-Real-IP and nothing else, so
	# it is set here from the resolved client address and every client-sent
	# lookalike is dropped.
	reverse_proxy api:8080 {
		header_up X-Real-IP {client_ip}
		header_up -True-Client-IP
	}
}

{$APP_DOMAIN} {
	import cloudflare_tls
	import security_headers
	import noindex
	encode zstd gzip
	reverse_proxy web:3000
}

# The bare domain is the site. Two addresses under /download are stable
# redirects the phone app and the docs rely on; the files live on the releases page.
{$ROOT_DOMAIN} {
	import cloudflare_tls
	import security_headers
	encode zstd gzip
	redir /download/android.json {$ANDROID_RELEASES_URL}/releases/latest/download/android.json 302
	redir /download/simhook.apk {$ANDROID_RELEASES_URL}/releases/latest/download/simhook.apk 302
	reverse_proxy site:80
}

www.{$ROOT_DOMAIN} {
	import cloudflare_tls
	import security_headers
	redir https://{$ROOT_DOMAIN}{uri} permanent
}
