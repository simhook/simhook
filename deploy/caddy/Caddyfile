# Values in {$...} come from the environment set in docker-compose.prod.yaml.
{
	email {$ACME_EMAIL}
	servers {
		# Cloudflare sits in front of us. Trust its ranges, and take the
		# visitor's address from the header only Cloudflare writes; anything a
		# client can send itself (X-Forwarded-For) is not believed.
		trusted_proxies cloudflare {
			interval 12h
			timeout 15s
		}
		client_ip_headers CF-Connecting-IP
	}
}

(cloudflare_tls) {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}
}

{$API_DOMAIN} {
	import cloudflare_tls
	encode zstd gzip
	# The API reads the visitor's address from X-Real-IP and nothing else, so
	# it is set here from the resolved client address and every client-sent
	# lookalike is dropped.
	reverse_proxy api:8080 {
		header_up X-Real-IP {client_ip}
		header_up -True-Client-IP
	}
}

{$APP_DOMAIN} {
	import cloudflare_tls
	encode zstd gzip
	reverse_proxy web:3000
}

# The bare domain is the site. Two addresses under /download are stable
# redirects the phone app and the docs rely on; the files live on the releases page.
{$ROOT_DOMAIN} {
	import cloudflare_tls
	encode zstd gzip
	redir /download/android.json {$ANDROID_RELEASES_URL}/releases/latest/download/android.json 302
	redir /download/simhook.apk {$ANDROID_RELEASES_URL}/releases/latest/download/simhook.apk 302
	reverse_proxy site:80
}

www.{$ROOT_DOMAIN} {
	import cloudflare_tls
	redir https://{$ROOT_DOMAIN}{uri} permanent
}
