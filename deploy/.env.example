# Host-level settings for docker-compose.prod.yaml. Copy to .env.
# Application settings for the API live in api.env (see api.env.example).

# Domains. Create proxied A records for all three in Cloudflare.
ROOT_DOMAIN=simhook.dev
API_DOMAIN=api.simhook.dev
APP_DOMAIN=app.simhook.dev

# Let's Encrypt notices go here.
ACME_EMAIL=you@example.com

# Cloudflare API token with Zone:DNS:Edit on the zone above. Caddy uses it to
# answer DNS challenges, so certificates keep renewing while the proxy is on.
CLOUDFLARE_API_TOKEN=

# Database password. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Days of nightly dumps to keep in ./backups.
BACKUP_KEEP_DAYS=14

# Leave unset to build images on this host. Set to pull published images instead.
# API_IMAGE=ghcr.io/simhook/api:latest
# WEB_IMAGE=ghcr.io/simhook/web:latest
# SITE_IMAGE=ghcr.io/simhook/site:latest

# Where the phone app's releases live. simhook.dev/download/* redirects there.
# ANDROID_RELEASES_URL=https://github.com/simhook/simhook
