# API settings for production. Copy to api.env.
# Database URL, public URLs, and the push credentials path are set by compose.

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Changing it later invalidates every session and every stored webhook secret.
SIMHOOK_SECRET_KEY=

# Transactional email over SMTP (verification codes, password resets, webhook
# pause notices). Any provider works: Postmark, Resend, Amazon SES, Mailgun.
SIMHOOK_SMTP_HOST=
SIMHOOK_SMTP_PORT=587
SIMHOOK_SMTP_USER=
SIMHOOK_SMTP_PASSWORD=
SIMHOOK_SMTP_FROM=simhook <noreply@simhook.dev>

SIMHOOK_LOG_LEVEL=info
SIMHOOK_REQUIRE_EMAIL_VERIFICATION=true

# Optional. Enables Google sign-in and Cloudflare Turnstile on the auth forms.
SIMHOOK_GOOGLE_CLIENT_ID=
SIMHOOK_TURNSTILE_SECRET_KEY=

# Dispatch and webhook tuning. Defaults are fine; see api/.env.example for the rest.
SIMHOOK_DISPATCH_WAVE_SIZE=40
SIMHOOK_WEBHOOK_MAX_PER_USER=5
