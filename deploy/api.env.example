# API settings for production. Copy to api.env.
# Database URL, public URLs, the cookie domain, and the push credentials path
# are set by compose from .env.

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# It encrypts stored webhook secrets. Changing it later means every webhook
# needs a new secret.
SIMHOOK_SECRET_KEY=

# Transactional email over SMTP (verification codes, password resets, webhook
# pause notices). Any provider works: Postmark, Resend, Amazon SES, Mailgun.
SIMHOOK_SMTP_HOST=
SIMHOOK_SMTP_PORT=587
SIMHOOK_SMTP_USER=
SIMHOOK_SMTP_PASSWORD=
SIMHOOK_SMTP_FROM=simhook <noreply@simhook.dev>

SIMHOOK_LOG_LEVEL=info
SIMHOOK_REQUIRE_EMAIL_VERIFICATION=true

# Sessions end after 30 days unused and 180 days after sign-in at the latest.
# SIMHOOK_SESSION_TTL_HOURS=720
# SIMHOOK_SESSION_MAX_HOURS=4320

# Optional, each needs both values. Google sign-in: an OAuth client whose
# redirect URI is https://<API_DOMAIN>/v1/auth/google/callback. Turnstile: a
# widget for <APP_DOMAIN>; the forms need a token while the keys are set.
SIMHOOK_GOOGLE_CLIENT_ID=
SIMHOOK_GOOGLE_CLIENT_SECRET=
SIMHOOK_TURNSTILE_SITE_KEY=
SIMHOOK_TURNSTILE_SECRET_KEY=

# Dispatch and webhook tuning. Defaults are fine; see api/.env.example for the rest.
SIMHOOK_DISPATCH_WAVE_SIZE=40
SIMHOOK_WEBHOOK_MAX_PER_USER=5
