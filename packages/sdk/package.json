{
  "name": "@simhook/sdk",
  "version": "0.1.1",
  "license": "MIT",
  "description": "Send and receive SMS through your own Android phone with the simhook API.",
  "keywords": [
    "sms",
    "text message",
    "android",
    "gateway",
    "webhooks",
    "simhook"
  ],
  "homepage": "https://simhook.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simhook/simhook.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@simhook/contracts": "workspace:*",
    "@types/node": "^24.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
