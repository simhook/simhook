---
import Base from "./Base.astro";
import { GUIDES, NAV, hasMarkdownTwin, type DocFrontmatter } from "../lib/docs";
import { breadcrumbs, formatUpdated, isoDate, normalizePath, ogImageFor, techArticle } from "../lib/seo";

interface Props {
  title?: string;
  headTitle?: string;
  description?: string;
  updated?: string;
  frontmatter?: DocFrontmatter;
}

const fm = Astro.props.frontmatter;
const title = fm?.title ?? Astro.props.title ?? "Docs";
const headTitle = fm?.headTitle ?? Astro.props.headTitle;
const description = fm?.description ?? Astro.props.description;
const updated = isoDate(fm?.updated ?? Astro.props.updated);
const path = normalizePath(Astro.url.pathname);
const markdown = hasMarkdownTwin(path) ? `${path}.md` : undefined;
const schema = [techArticle({ url: path, title: headTitle ?? title, description, updated, image: ogImageFor(path) }), breadcrumbs([["Docs", "/docs"], [title, path]])];
const current = (href: string) => (path === href ? "page" : undefined);
---

<Base title={title} headTitle={headTitle} description={description} type="article" updated={updated} markdown={markdown} schema={schema} measure="doc">
  <nav class="docs-nav" aria-label="Documentation">
    {NAV.map(([href, label]) => <a href={href} aria-current={current(href)}>{label}</a>)}
  </nav>
  <nav class="docs-nav" aria-label="Guides">
    <span class="meta">guides</span>
    {GUIDES.map(([href, label]) => <a href={href} aria-current={current(href)}>{label}</a>)}
  </nav>
  <article class="doc">
    <h1>{title}</h1>
    {updated && <p class="meta"><time datetime={updated}>updated {formatUpdated(updated)}</time></p>}
    <slot />
  </article>
</Base>
