---
import "@fontsource-variable/instrument-sans";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Reading width of the content inside the shell. The bar and footer never change. */
  measure?: "prose" | "doc" | "form";
}

const {
  title,
  description = "Turn an Android phone into an SMS API. Send and receive texts from your code through your own SIM, with webhooks, an SDK, and an MCP server.",
  measure = "prose",
} = Astro.props;

const app = (import.meta.env.PUBLIC_APP_URL as string | undefined) || "https://app.simhook.dev";
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
const here = new URL(path === "/" ? "/" : path, Astro.site);
const nav = [
  ["/docs", "Docs"],
  ["/pricing", "Pricing"],
  ["/download", "Download"],
  ["https://github.com/simhook/simhook", "GitHub"],
];
const current = (href: string) => (href.startsWith("/") && (path === href || path.startsWith(href + "/")) ? "page" : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={here} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={here} />
    <meta property="og:site_name" content="simhook" />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      // Runs before anything is painted. The API keeps a readable cookie
      // next to the session while a browser is signed in, so the bar can be
      // drawn right from the first frame without asking anyone.
      if (/(^|;\s*)simhook_signed_in=/.test(document.cookie)) document.documentElement.dataset.session = "in";
    </script>
  </head>
  <body>
    <div class="page">
      <nav class="top" aria-label="Main">
        <a class="wm" href="/">simhook</a>
        <span class="links">{nav.map(([href, label]) => <a href={href} aria-current={current(href)}>{label}</a>)}</span>
        <span class="right">
          <a class="when-out" href={`${app}/login`}>Sign in</a>
          <a class="when-in" href={`${app}/dashboard`}>Dashboard</a>
          <a class="when-in" href="#" data-signout>Sign out</a>
        </span>
      </nav>
      <main class:list={[`measure-${measure}`]}>
        <slot />
      </main>
      <footer class="bottom">
        <span>Open source, AGPL-3.0</span>
        <a href="https://github.com/simhook/simhook">GitHub</a>
        <a href="/docs">Docs</a>
        <a href="https://github.com/simhook/simhook/blob/main/SECURITY.md">Security</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </footer>
    </div>
    <script>
      // The page is static, but the visitor may be signed in to the app. The
      // API keeps a readable flag cookie in step with the session, so the bar
      // follows the cookie: read again whenever the page is shown again
      // (back and forward restore pages without running them) and after
      // signing out here, which the API answers by clearing the cookie.
      const api = (import.meta.env.PUBLIC_API_URL as string | undefined) || "https://api.simhook.dev";
      const root = document.documentElement;
      const sync = () => {
        if (/(^|;\s*)simhook_signed_in=/.test(document.cookie)) root.dataset.session = "in";
        else delete root.dataset.session;
      };
      sync();
      window.addEventListener("pageshow", sync);
      document.querySelector("[data-signout]")?.addEventListener("click", (e) => {
        e.preventDefault();
        fetch(`${api}/v1/auth/logout`, { method: "POST", credentials: "include" })
          .catch(() => {})
          .finally(sync);
      });
    </script>
  </body>
</html>
