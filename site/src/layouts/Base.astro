---
import "@fontsource-variable/instrument-sans";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Reading width of the content inside the shell. The bar and footer never change. */
  measure?: "prose" | "doc" | "form";
}

const {
  title,
  description = "Turn an Android phone into an SMS API. Send and receive texts from your code through your own SIM, with webhooks, an SDK, and an MCP server.",
  measure = "prose",
} = Astro.props;

const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
const nav = [
  ["/docs", "Docs"],
  ["/pricing", "Pricing"],
  ["/download", "Download"],
  ["https://github.com/simhook/simhook", "GitHub"],
];
const current = (href: string) => (href.startsWith("/") && (path === href || path.startsWith(href + "/")) ? "page" : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(path === "/" ? "/" : path, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      // Runs before anything is painted: if this browser was signed in the last
      // time it asked, draw the bar that way from the first frame.
      try {
        if (localStorage.getItem("simhook:session") === "in") document.documentElement.dataset.session = "in";
      } catch {}
    </script>
  </head>
  <body>
    <div class="page">
      <nav class="top" aria-label="Main">
        <a class="wm" href="/">simhook</a>
        <span class="links">{nav.map(([href, label]) => <a href={href} aria-current={current(href)}>{label}</a>)}</span>
        <span class="right">
          <a class="when-out" href="https://app.simhook.dev/login">Sign in</a>
          <a class="when-in" href="https://app.simhook.dev/dashboard">Dashboard</a>
          <a class="when-in" href="#" data-signout>Sign out</a>
        </span>
      </nav>
      <main class:list={[`measure-${measure}`]}>
        <slot />
      </main>
      <footer class="bottom">
        <span>Open source, AGPL-3.0</span>
        <a href="https://github.com/simhook/simhook">GitHub</a>
        <a href="/docs">Docs</a>
        <a href="https://github.com/simhook/simhook/blob/main/SECURITY.md">Security</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </footer>
    </div>
    <script>
      // The page is static, but the visitor may be signed in to the app. Ask the
      // API once per page, remember the answer for the next page, and only touch
      // the bar when the answer differs from what is already drawn.
      const api = (import.meta.env.PUBLIC_API_URL as string | undefined) ?? "https://api.simhook.dev";
      const root = document.documentElement;
      const remember = (state: "in" | "out") => {
        if (state === "in") root.dataset.session = "in";
        else delete root.dataset.session;
        try {
          localStorage.setItem("simhook:session", state);
        } catch {}
      };
      fetch(`${api}/v1/auth/me`, { credentials: "include" })
        .then((r) => remember(r.ok ? "in" : "out"))
        .catch(() => {});
      document.querySelector("[data-signout]")?.addEventListener("click", (e) => {
        e.preventDefault();
        remember("out");
        fetch(`${api}/v1/auth/logout`, { method: "POST", credentials: "include" }).catch(() => {});
      });
    </script>
  </body>
</html>
