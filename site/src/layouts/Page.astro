---
import Base from "./Base.astro";

interface Props {
  frontmatter: { title: string; description?: string };
}

const { frontmatter } = Astro.props;
---

<Base title={`${frontmatter.title} · simhook`} description={frontmatter.description}>
  <article class="doc">
    <h1>{frontmatter.title}</h1>
    <slot />
  </article>
</Base>
