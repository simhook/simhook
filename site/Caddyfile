# Serves the built site inside the container. TLS and the public hostname are
# handled by the edge Caddy in deploy/caddy, which proxies to this one.
:80 {
	root * /srv
	encode zstd gzip

	# Every page has one address, without a trailing slash.
	@trailing path_regexp trail ^/(.+)/$
	redir @trailing /{re.trail.1} 308

	# Clean addresses: /pricing serves pricing.html, /docs serves docs/index.html.
	try_files {path}.html {path}/index.html {path}
	file_server

	handle_errors {
		@notfound expression {http.error.status_code} == 404
		rewrite @notfound /404.html
		file_server
	}

	# Hashed assets never change. Pages are revalidated on every visit (a 304
	# costs nothing), so a deploy is visible the moment it lands. Each response
	# matches exactly one of these, so none can override another.
	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@images path /img/* /favicon.svg /favicon.png /apple-touch-icon.png
	header @images Cache-Control "public, max-age=86400"
	@pages not path /_astro/* /img/* /favicon.svg /favicon.png /apple-touch-icon.png
	header @pages Cache-Control "no-cache"
}
