# Serves the built site inside the container. TLS and the public hostname are
# handled by the edge Caddy in deploy/caddy, which proxies to this one.
:80 {
	root * /srv
	encode zstd gzip

	# Every page has one address, without a trailing slash.
	@trailing path_regexp trail ^/(.+)/$
	redir @trailing /{re.trail.1} 308

	# An agent may ask for a page as Markdown (Accept: text/markdown). A page
	# with a Markdown twin answers with the twin at the same address; browsers
	# keep the HTML, and Vary tells caches the answer depends on Accept.
	@hasTwin file {path}.md
	header @hasTwin Vary Accept
	@wantsMarkdown {
		header_regexp Accept text/markdown
		file {path}.md
	}
	header @wantsMarkdown Content-Type "text/markdown; charset=utf-8"
	rewrite @wantsMarkdown {path}.md

	# Where the API is, for agents that start at the front door (RFC 8288
	# link relations; the catalog itself follows RFC 9727).
	header / Link "</.well-known/api-catalog>; rel=\"api-catalog\", </docs/api>; rel=\"service-doc\""
	header /.well-known/api-catalog Content-Type "application/linkset+json"

	# Clean addresses: /pricing serves pricing.html, /docs serves docs.html
	# (Astro writes every page as <route>.html). Files that exist are served
	# as they are: /docs/sending.md, /llms.txt, /og/home.png.
	try_files {path}.html {path}/index.html {path}
	file_server

	handle_errors {
		@notfound expression {http.error.status_code} == 404
		rewrite @notfound /404.html
		file_server
	}

	# Types Go's built-in table does not know, set before file_server runs.
	header /site.webmanifest Content-Type "application/manifest+json"
	header /favicon.ico Content-Type "image/x-icon"
	@markdown path *.md
	header @markdown Content-Type "text/markdown; charset=utf-8"
	@agentText path /llms.txt /llms-full.txt
	header @agentText Content-Type "text/plain; charset=utf-8"

	# The Markdown twins and the agent index are for fetching, not for the
	# search index: the HTML page is the one address a search result points at.
	@machine path *.md /llms.txt /llms-full.txt
	header @machine X-Robots-Tag "noindex"

	# Hashed assets never change. Brand files and share images change rarely
	# and keep their names, so a day is right for them. Pages are revalidated on
	# every visit (a 304 costs nothing), so a deploy is visible the moment it
	# lands. Each response matches exactly one of these groups.
	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@assets path /img/* /og/* /brand/* /favicon.* /icon-*.png /apple-touch-icon.png /site.webmanifest
	header @assets Cache-Control "public, max-age=86400"
	@pages not path /_astro/* /img/* /og/* /brand/* /favicon.* /icon-*.png /apple-touch-icon.png /site.webmanifest
	header @pages Cache-Control "no-cache"
}
