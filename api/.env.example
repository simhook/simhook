# simhook API configuration. Copy to .env for local development.
# Every variable is prefixed SIMHOOK_. Values shown are dev defaults.

# --- Server ---
SIMHOOK_ENV=development                 # development | production
SIMHOOK_HTTP_ADDR=:8080
SIMHOOK_PUBLIC_URL=http://localhost:8080
SIMHOOK_WEB_URL=http://localhost:3000   # dashboard origin, used for CORS, the origin check, and email links
SIMHOOK_SITE_URL=http://localhost:4321  # the public site when it is served separately; it may sign visitors out
SIMHOOK_LOG_LEVEL=debug                 # debug | info | warn | error
SIMHOOK_TRUST_PROXY=false               # true only behind the proxy in deploy/, which fills X-Real-IP

# --- Database (also used by the job queue) ---
SIMHOOK_DATABASE_URL=postgres://simhook:simhook@localhost:5432/simhook?sslmode=disable

# --- Secrets ---
# 32 random bytes, base64. Generate with: openssl rand -base64 32
SIMHOOK_SECRET_KEY=                     # encrypts stored webhook secrets; every other credential is hashed

# --- Push (Firebase Cloud Messaging) ---
# Path to the Firebase service-account JSON. Leave empty in dev to use the
# no-op push channel, which logs pushes instead of sending them.
SIMHOOK_FCM_CREDENTIALS_FILE=

# --- Email ---
SIMHOOK_SMTP_HOST=localhost
SIMHOOK_SMTP_PORT=1025
SIMHOOK_SMTP_USER=
SIMHOOK_SMTP_PASSWORD=
SIMHOOK_SMTP_FROM=simhook <noreply@simhook.dev>

# --- Dispatch tuning ---
SIMHOOK_DISPATCH_WAVE_SIZE=40           # messages released per wave to one device
SIMHOOK_PUSH_TTL_SECONDS=86400          # how long the push provider holds a wake-up for an offline phone (24h); a queued message waits this long for the phone
SIMHOOK_STALE_AFTER_MINUTES=15          # a fetched message with no report this long after the phone should have sent it becomes unknown
SIMHOOK_OFFLINE_AFTER_MINUTES=45        # no heartbeat for this long marks a device offline
SIMHOOK_HEARTBEAT_INTERVAL_MINUTES=20   # default interval handed to newly paired phones

# --- Webhooks ---
SIMHOOK_WEBHOOK_TIMEOUT_SECONDS=30
SIMHOOK_WEBHOOK_MAX_PER_USER=5
SIMHOOK_WEBHOOK_ALLOW_PRIVATE_HOSTS=false   # true only for self-hosting on a LAN; also allows plain http URLs

# --- Sessions ---
SIMHOOK_SESSION_TTL_HOURS=720           # a session ends after this long unused (30 days); use extends it
SIMHOOK_SESSION_MAX_HOURS=4320          # and ends for good this long after sign-in (180 days), however active
SIMHOOK_COOKIE_DOMAIN=                  # domain of the readable signed-in flag cookie, e.g. simhook.dev; must be a parent
                                        # of the API, dashboard, and site hosts. Empty means this host only (localhost).
SIMHOOK_REQUIRE_EMAIL_VERIFICATION=true
SIMHOOK_GOOGLE_CLIENT_ID=               # optional, enables Google sign-in
SIMHOOK_TURNSTILE_SECRET_KEY=           # optional, enables Cloudflare Turnstile on auth forms
